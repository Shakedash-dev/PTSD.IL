    {
      "_key": "ד\"ר דני ברום",
      "title": "Dr. Danny Brom",
      "sortOrder": 0,
      "content": {
        "_key": "ד\"ר דני ברום",
        "_col": "metiv-team",
        "name": "Dr. Danny Brom",
        "role": "Founder and CEO of Metiv",
        "group": "Management",
        "bio": "Dr. Danny Brom is an expert in trauma and resilience. As the founder of Metiv, he brought his trauma expertise to the fields of education, health, mental health and community. He taught at the Hebrew University's School of Social Work, founded the Israel Trauma Coalition and served as its chair, and was research director of AMCHA, which provides psychosocial support to Holocaust survivors and the second generation. Internationally, he provides training and consultation on trauma and resilience to professionals and service providers following terror attacks and disasters, including in New York after 9/11, Haiti, Turkey, New Orleans and Mexico. He has co-authored 50 papers published in professional journals and has co-written seven books on trauma.",
        "releaseJourneyTeam": false,
        "releaseJourneyResearcher": false
      }
    },
