    {
      "_key": "ד\"ר דני ברום",
      "title": "د. داني بروم",
      "sortOrder": 0,
      "content": {
        "_key": "ד\"ר דני ברום",
        "_col": "metiv-team",
        "name": "د. داني بروم",
        "role": "مؤسّس ميتيف ومديره العام",
        "group": "الإدارة",
        "bio": "د. داني بروم خبير في مجال الصدمة والمناعة النفسية. بصفته مؤسّس ميتيف، نقل خبرته في الصدمة إلى مجالات التربية والصحة والصحة النفسية والمجتمع. درّس في مدرسة العمل الاجتماعي في الجامعة العبرية، وأسّس الائتلاف الإسرائيلي للصدمات النفسية وترأّسه، وشغل منصب مدير الأبحاث في AMCHA التي تقدّم دعمًا نفسيًا اجتماعيًا للجيل الأول والثاني من الناجين من المحرقة. وعلى الصعيد الدولي يقدّم الإشراف المهني والاستشارة في الصدمة والمناعة النفسية للمهنيين ومقدّمي الخدمات في أعقاب العمليات الإرهابية والكوارث، بما في ذلك نيويورك بعد 9/11، وهايتي، وتركيا، ونيو أورلينز، والمكسيك. شارك في 50 مقالًا نُشرت في مجلات مهنية وفي تأليف سبعة كتب في مجال الصدمة.",
        "releaseJourneyTeam": false,
        "releaseJourneyResearcher": false
      }
    },
