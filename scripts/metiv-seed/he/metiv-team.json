    {
      "_key": "ד\"ר דני ברום",
      "title": "ד\"ר דני ברום",
      "sortOrder": 0,
      "content": {
        "_key": "ד\"ר דני ברום",
        "_col": "metiv-team",
        "name": "ד\"ר דני ברום",
        "role": "מייסד ומנכ\"ל מטיב",
        "group": "הנהלה",
        "bio": "ד\"ר דני ברום הוא מומחה בתחום הטראומה והחוסן. כמייסד מטיב, הביא את מומחיותו בטראומה לתחומי החינוך, הבריאות, בריאות הנפש והקהילה. לימד בבית הספר לעבודה סוציאלית באוניברסיטה העברית, הקים את הקואליציה הישראלית לטראומה וכיהן בה כיו\"ר, ושימש כמנהל המחקר של AMCHA המספקת תמיכה פסיכו-סוציאלית לדור ראשון ושני לניצולי שואה. בעולם, מקיים הדרכות וייעוץ בטראומה וחוסן לאנשי מקצוע ונותני שירותים בעקבות פיגועי טרור ואסונות, כולל ניו יורק לאחר 9/11, האיטי, טורקיה, ניו אורלינס ומקסיקו. היה שותף ל-50 מאמרים שפורסמו בכתבי עת מקצועיים ולכתיבת שבעה ספרים בתחום הטראומה.",
        "releaseJourneyTeam": false,
        "releaseJourneyResearcher": false
      }
    },
